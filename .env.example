# Copy to .env.local and fill in. Never commit .env* files with real keys.

# Browser + server client (RLS-protected
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Service role — bypasses RLS. Keep secret. Only used by server-admin endpoints if you add them)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key